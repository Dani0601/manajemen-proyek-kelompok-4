    {
      "name": "01 - Dashboard",
      "item": [
        {
          "name": "GET Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[200] Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"[Header] Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"[Performance] Response time is below 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"[Body] Structure matches standard response schema\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"object\");",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json.data).to.be.an(\"object\");",
                  "    pm.expect(json.data).to.have.property(\"season\");",
                  "    pm.expect(json.data).to.have.property(\"schedule\");",
                  "    pm.expect(json.data.schedule).to.be.an(\"array\");",
                  "",
                  "    if (json.data.season && json.data.season.season_id) {",
                  "        pm.collectionVariables.set(\"seasonId\", String(json.data.season.season_id));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard"]
            }
