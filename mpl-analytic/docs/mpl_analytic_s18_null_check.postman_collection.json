    "name": "MPL Analytic API - Season 18 Null Check (Data-Driven)",
    "description": "Postman Collection data-driven khusus Season 18 MPL Indonesia untuk memastikan tidak ada data NULL di seluruh ID.\n\nCara Penggunaan di Postman:\n1. Buka Runner (Collection Runner)\n2. Pilih Folder yang ingin dites\n3. Di bagian 'Select Data File', pilih file CSV yang sesuai:\n   - Folder Heroes -> docs/data_hero_ids.csv (133 hero)\n   - Folder Players -> docs/data_player_ids.csv (60 player)\n   - Folder Teams -> docs/data_team_ids.csv (9 team)\n   - Folder Matches -> docs/data_match_ids.csv (72 match)\n   - Folder Games -> docs/data_game_ids.csv (132 game)\n   - Folder Season 18 Tournament -> langsung Run (1 iterasi)\n4. Klik Run untuk mengeksekusi semua iterasi secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/manajemen-proyek-kelompok-4/mpl-analytic/public",
      "type": "string",
      "description": "Base URL Backend API"
    },
    {
      "key": "seasonId",
      "value": "1",
      "type": "string",
      "description": "ID Season 18 di database"
    }
  ],
  "item": [
    {
      "name": "01 - Season 18 Dashboard & Tournaments (No CSV needed)",
      "description": "Pemeriksaan data Season 18 pada endpoint Dashboard dan Tournament agar tidak ada null.",
      "item": [
        {
          "name": "GET /api/dashboard?season=1 - Dashboard Season 18",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Data dashboard tidak null', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data, 'data').to.not.be.null;",
                  "    pm.expect(res.data.season, 'data.season').to.not.be.null;",
                  "    pm.expect(res.data.season.season_id, 'season_id').to.equal(1);",
                  "    pm.expect(res.data.top_pick_rate, 'top_pick_rate').to.be.an('array');",
                  "    pm.expect(res.data.top_ban_rate, 'top_ban_rate').to.be.an('array');",
                  "    pm.expect(res.data.top_win_rate, 'top_win_rate').to.be.an('array');",
                  "    pm.expect(res.data.schedule, 'schedule').to.be.an('array');",
                  "});",
                  "pm.test('Hero meta di dashboard tidak ada data null', () => {",
                  "    const picks = pm.response.json().data.top_pick_rate || [];",
                  "    picks.forEach((h, i) => {",
                  "        pm.expect(h.hero_id, `pick[${i}].hero_id`).to.not.be.null;",
                  "        pm.expect(h.hero_name, `pick[${i}].hero_name`).to.not.be.null.and.not.equal('');",
                  "        pm.expect(h.hero_url, `pick[${i}].hero_url`).to.not.be.null.and.not.equal('');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard?season={{seasonId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ],
              "query": [
                {
                  "key": "season",
                  "value": "{{seasonId}}"
                }
              ]
            }
          },
          "response": []
        },
